---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order).slice(0, 2);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base title="Fahmi Nugroho — Software engineer">
  <h1 class="lede">
    I'm Fahmi Nugroho, a software engineer from Indonesia. I build web applications, work close to
    Linux and databases, and write down what I learn so the next attempt is faster.
  </h1>
  <p>
    Currently interested in web development, system design, PostgreSQL, and self-hosting.
    <a href="mailto:fahminugroho23@gmail.com">Email me</a> or read more <a href="/about/">about me</a>.
  </p>

  <h2>Writing</h2>
  <ul class="entries">
    {
      posts.map((post) => (
        <li>
          <a class="title" href={`/writing/${post.id}/`}>
            {post.data.title}
          </a>
          <p class="meta">
            {fmt(post.data.date)}
            {post.data.lang === 'id' && ' · Indonesian'}
          </p>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
  <p><a href="/writing/">All writing →</a></p>

  <h2>Selected projects</h2>
  <ul class="entries">
    {
      projects.map((project) => (
        <li>
          <a class="title" href={project.data.repo}>
            {project.data.title} <span aria-hidden="true">↗</span>
          </a>
          <p>{project.data.description}</p>
          {project.data.stack.length > 0 && <p class="meta">{project.data.stack.join(' · ')}</p>}
        </li>
      ))
    }
  </ul>
  <p><a href="/projects/">All projects →</a></p>
</Base>
